<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="CapsuleBtnTemplate" TargetType="{x:Type ToggleButton}">
        <ControlTemplate.Resources>
            <Storyboard x:Key="StartAnimation">
                <ColorAnimation Storyboard.TargetName="BackgroundBorder" 
                                Storyboard.TargetProperty="Background.Color"
                                To="#8fa7fe" Duration="0:0:0.2"/>
                <DoubleAnimation Storyboard.TargetName="DotTranslate" 
                                 Storyboard.TargetProperty="X"
                                 To="9" Duration="0:0:0.2"/>
            </Storyboard>

            <Storyboard x:Key="StopAnimation">
                <ColorAnimation Storyboard.TargetName="BackgroundBorder" 
                                Storyboard.TargetProperty="Background.Color"
                                To="#FFE5E5E5" Duration="0:0:0.2"/>
                <DoubleAnimation Storyboard.TargetName="DotTranslate" 
                                 Storyboard.TargetProperty="X"
                                 To="-9" Duration="0:0:0.2"/>
            </Storyboard>
        </ControlTemplate.Resources>

        <Grid>
            <Border x:Name="BackgroundBorder" 
                    CornerRadius="10" 
                    Width="40" 
                    Height="20">
                <Border.Background>
                    <SolidColorBrush Color="#FFE5E5E5"/>
                </Border.Background>
            </Border>

            <Ellipse x:Name="Dot" 
                     Width="18" 
                     Height="18" 
                     Fill="White" 
                     StrokeThickness="0">
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="DotTranslate" X="-9"/>
                </Ellipse.RenderTransform>
            </Ellipse>
        </Grid>

        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource StartAnimation}"/>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard Storyboard="{StaticResource StopAnimation}"/>
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>