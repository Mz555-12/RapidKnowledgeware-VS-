<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ControlTemplate TargetType="RadioButton" x:Key="RadioButtonTemple">
        <Grid>
            <Border Background="#00FFFFFF" CornerRadius="5" Name="back" Height="40" Width="174"  BorderThickness="0.5" BorderBrush="#0a59f7"/>
               
            <TextBlock Text="{TemplateBinding Content}"  FontSize="17"  Name="text" VerticalAlignment="Center"  FontFamily="Microsoft YaHei"  HorizontalAlignment="Center" />
        </Grid>

        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#e6e5e6" TargetName="back"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="true">
                <Setter Property="Background" Value="#d6deee" TargetName="back"/>
                <Setter Property="BorderThickness" Value="0" TargetName="back"/>
                <Setter Property="Foreground" Value="#0a59f7" TargetName="text"/>
                <Setter Property="FontWeight" Value="Black" TargetName="text"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>