<UserControl x:Class="RapidKnowledgeware.Views.ModelAdjustView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RapidKnowledgeware.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="608"  FontSize="15">
    <Grid Background="White" >
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5 0 0 0">
            <Label Content="LLM提供商：" FontWeight="Bold"/>
            <TextBlock Text="Ollama" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <StackPanel Orientation="Vertical" Margin="20 10 0 0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0 20 0 0">
                    <Label Content="ChatModel：" FontWeight="Bold"/>
                    <TextBox Text="{Binding ChatModel}" VerticalAlignment="Center" HorizontalAlignment="Center" 
              BorderThickness="0 0 0 1" Padding="10 0" MinWidth="100"  />
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0 35">
                    <Label Content="BaseURL：" FontWeight="Bold"/>
                    <TextBox Text="{Binding BaseURL}" VerticalAlignment="Center" HorizontalAlignment="Center" 
              BorderThickness="0 0 0 1" Padding="10 0"  MinWidth="100"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0 0 0 0">
                    <Label Content="上下文记忆长度：" FontSize="16" FontWeight="Bold"/>
                    <TextBox Text="{Binding ContextSize}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="16"
              BorderThickness="0 0 0 1" Padding="10 0"  MinWidth="100"/>
                </StackPanel>
            </StackPanel>

        </Grid>

    </Grid>
</UserControl>
