<Window x:Class="RapidKnowledgeware.Views.DebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:RapidKnowledgeware.Converters"
        Title="调试窗口" Height="450" Width="700"
        WindowStartupLocation="Manual" Left="0" Top="0"
        FontFamily="Consolas" FontSize="15" Background="{x:Null}" WindowStyle="None" AllowsTransparency="True">
    <Window.Resources>

        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Assets/Styles/MainWindowStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- 日志级别颜色转换器 -->
            <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
            <converters:DebugLevelToColorConverter x:Key="LevelToColorConverter"/>
        </ResourceDictionary>

    </Window.Resources>

    <Border Background="White" Margin="5" CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect Color="Gray" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
        </Border.Effect>


        <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" CornerRadius="10 10 0 0"  Style="{StaticResource TitleBarStyle}" MouseLeftButtonDown="RowDefinition_MouseLeftButtonDown">

            <Grid>
                <StackPanel Orientation="Horizontal" Margin="15 0 0 0">
                    <Button Content="清空日志" Width="80" Height="25" Command="{Binding ClearCommand}" Template="{StaticResource ButtonTemplate2}"/>
                    <CheckBox x:Name="AutoScrollCheck" Content="自动滚动" IsChecked="True" Margin="10,3,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Height="30" Width="40" Template="{StaticResource ButtonTemplate}" 
                    Content="&#xe601;" FontWeight="Bold" BorderThickness="0" 
                    Background="#55DAE3EA" 
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"
                    Click="Close_DebugView"/>
            </Grid>
        </Border>

        <!-- 日志列表 -->
        <ScrollViewer Grid.Row="1" x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">

            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}"/>
            </ScrollViewer.Resources>

            <ListBox ItemsSource="{Binding DebugModel.LogEntries}" AlternationCount="2" 
         Background="Transparent" BorderThickness="0" 
         HorizontalContentAlignment="Stretch"
         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <!-- 禁用内置垂直滚动，交给外层 ScrollViewer -->
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}" 
                                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" 
                                Padding="8,4">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                <Setter Property="Background" Value="#F5F5F5"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- 时间戳（保留为 TextBlock，无需复制） -->
                            <TextBlock Text="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm:ss.fff'}" 
                           Foreground="#666" VerticalAlignment="Top"/>
                            <!-- 级别标签 -->
                            <TextBlock Grid.Column="1" Text="{Binding Level}" Width="45" Margin="5,0"
                           Foreground="{Binding Level, Converter={StaticResource LevelToColorConverter}}" 
                           FontWeight="Bold" VerticalAlignment="Top"/>
                            <!-- 消息内容：使用只读 TextBox 支持选择和复制 -->
                            <StackPanel Grid.Column="2">
                                <TextBox Text="{Binding Message}" 
                             IsReadOnly="True" 
                             Background="Transparent" 
                             BorderThickness="0"
                             TextWrapping="Wrap" 
                             Margin="0,0,0,3"
                             Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                                <!-- 异常详情 -->
                                <TextBox Text="{Binding ExceptionDetail}" 
                             IsReadOnly="True"
                             Background="Transparent" 
                             BorderThickness="0"
                             Foreground="#C7254E" 
                             TextWrapping="Wrap" 
                             FontSize="11"
                             Margin="0,2,0,0"
                             Visibility="{Binding ExceptionDetail, Converter={StaticResource StringToVisibilityConverter}}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>
    </Grid> 
    </Border>
  
</Window>