<Window x:Class="RapidKnowledgeware.Views.DebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:RapidKnowledgeware.Converters"
        Title="调试窗口" Height="450" Width="700"
        WindowStartupLocation="Manual" Left="0" Top="0"
        FontFamily="Consolas" FontSize="15">
    <Window.Resources>
        <!-- 日志级别颜色转换器 -->
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <converters:DebugLevelToColorConverter x:Key="LevelToColorConverter"/>
        
        
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" Background="#F0F0F0" BorderBrush="#CCC" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="5,0">
                <Button Content="清空日志" Width="80" Height="22" Command="{Binding ClearCommand}"/>
                <CheckBox x:Name="AutoScrollCheck" Content="自动滚动" IsChecked="True" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 日志列表 -->
        <ScrollViewer Grid.Row="1" x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
            <ListBox ItemsSource="{Binding DebugModel.LogEntries}" AlternationCount="2" 
         Background="Transparent" BorderThickness="0" 
         HorizontalContentAlignment="Stretch"
         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <!-- 禁用内置垂直滚动，交给外层 ScrollViewer -->
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}" 
                                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" 
                                Padding="8,4">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                <Setter Property="Background" Value="#F5F5F5"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- 时间戳（保留为 TextBlock，无需复制） -->
                            <TextBlock Text="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm:ss.fff'}" 
                           Foreground="#666" VerticalAlignment="Top"/>
                            <!-- 级别标签 -->
                            <TextBlock Grid.Column="1" Text="{Binding Level}" Width="45" Margin="5,0"
                           Foreground="{Binding Level, Converter={StaticResource LevelToColorConverter}}" 
                           FontWeight="Bold" VerticalAlignment="Top"/>
                            <!-- 消息内容：使用只读 TextBox 支持选择和复制 -->
                            <StackPanel Grid.Column="2">
                                <TextBox Text="{Binding Message}" 
                             IsReadOnly="True" 
                             Background="Transparent" 
                             BorderThickness="0"
                             TextWrapping="Wrap" 
                             Margin="0,0,0,3"
                             Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                                <!-- 异常详情 -->
                                <TextBox Text="{Binding ExceptionDetail}" 
                             IsReadOnly="True"
                             Background="Transparent" 
                             BorderThickness="0"
                             Foreground="#C7254E" 
                             TextWrapping="Wrap" 
                             FontSize="11"
                             Margin="0,2,0,0"
                             Visibility="{Binding ExceptionDetail, Converter={StaticResource StringToVisibilityConverter}}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>
    </Grid>
</Window>