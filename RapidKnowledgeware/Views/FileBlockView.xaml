<UserControl x:Class="RapidKnowledgeware.Views.FileBlockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RapidKnowledgeware.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="608">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/MainWindowStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏，右侧关闭按钮 -->
        <Border Grid.Row="0" Background="#F0F0F0" BorderBrush="#DDD" BorderThickness="0 0 0 1">
            <Grid>
                <TextBlock Text="文档分块预览" VerticalAlignment="Center" Margin="10 0 0 0" FontWeight="Bold"/>
                <Button Height="30" Width="40" 
                        Template="{StaticResource ButtonTemplate}" 
                        Content="&#xe601;" FontWeight="Bold" BorderThickness="0"  
                        Background="#55DAE3EA" HorizontalAlignment="Right" Margin="0 0 5 0"
                        Command="{Binding CloseFileBlockViewCommand}"/>
            </Grid>
        </Border>

        <!-- 分块列表 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding KnowledgeBaseModel.FileBlocks}" 
              AlternationCount="1000" Margin="5">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" 
                    Margin="0 0 0 10" Padding="8" Background="#FAFAFA">
                            <StackPanel>
                                <TextBlock Text="{Binding RelativeSource={RelativeSource TemplatedParent}, 
                                              Path=(ItemsControl.AlternationIndex), 
                                              StringFormat='块 {0}'}"
                               FontWeight="Bold" Foreground="#2C3E50" Margin="0 0 0 5"/>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="13"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>