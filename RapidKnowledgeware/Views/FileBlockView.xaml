<UserControl x:Class="RapidKnowledgeware.Views.FileBlockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RapidKnowledgeware.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="608">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Assets/Styles/MainWindowStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏，右侧关闭按钮 -->
        <Border Grid.Row="0" Background="#f7fbff" >
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal">
                        <Label Content="当前文件为:" VerticalAlignment="Center" Margin="10 0 0 0" FontWeight="Bold"/>
                        <TextBlock  Text="{Binding KnowledgeBaseModel.CurrentFileName}" VerticalAlignment="Center" Margin="10 0 10 0" FontSize="14" MinWidth="50" MaxWidth="185"/>

                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label Content="当前分块规则为:" VerticalAlignment="Center" Margin="10 0 0 0" FontWeight="Bold"/>
                        <TextBlock  Text="{Binding KnowledgeBaseModel.CurrentFileBlockRule}" VerticalAlignment="Center" Margin="10 0 20 0" FontSize="14" MinWidth="50" MaxWidth="150"/>
                    </StackPanel>
                </StackPanel>


                <Button Height="30" Width="40" 
                        Template="{StaticResource ButtonTemplate}" 
                        Content="&#xe601;" FontWeight="Bold" BorderThickness="0"  
                        Background="#55DAE3EA" HorizontalAlignment="Right" Margin="0 0 5 0"
                        Command="{Binding CloseFileBlockViewCommand}"/>
            </Grid>
        </Border>

        <!-- 分块列表 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">

            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}"/>
            </ScrollViewer.Resources>

            <ItemsControl ItemsSource="{Binding KnowledgeBaseModel.FileBlocks}" 
              AlternationCount="1000" Margin="5">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#bfdbfe" BorderThickness="1" CornerRadius="4" 
            Margin="0 0 0 10" Padding="8" Background="#07007DFA">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <!-- 标题行：左侧序号，右侧删除按钮 -->
                                <Grid Grid.Row="0">
                                    <TextBlock Text="{Binding RelativeSource={RelativeSource TemplatedParent}, 
                                          Path=(ItemsControl.AlternationIndex), 
                                          StringFormat='块 {0}'}"
                           FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center"/>
                                    <!-- 删除按钮修改为 -->
                                    <Button Content="🗑️" Width="24" Height="24" HorizontalAlignment="Right"
                                        ToolTip="删除此块"
                                        Command="{Binding DataContext.DeleteChunkCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent" BorderThickness="0" Foreground="Red"
                                        Visibility="{Binding DataContext.HasMultipleChunks, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                                <!-- 块内容 -->
                                <TextBox Grid.Row="1" Text="{Binding Content}" TextWrapping="Wrap" FontSize="13" Margin="0 5 0 0"
         IsReadOnly="True" BorderThickness="0" Background="Transparent" 
         Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
         IsReadOnlyCaretVisible="False" Cursor="Arrow"/>
                                
                                 </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>