<UserControl x:Class="RapidKnowledgeware.Views.SpaceParametersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RapidKnowledgeware.Views"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="797">


    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Assets/Styles/SpaceParametersStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>

    </UserControl.Resources>
    <Border Background="White">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/> 
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <!-- 分隔条 -->
            <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Stretch" Background="#B4D6F1" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"/>

            <!-- 左侧菜单 -->
            <Grid>
                <StackPanel VerticalAlignment="Center" Margin="10 0 5 0">
                    <RadioButton  Content="知识库"  IsChecked="True" Template="{StaticResource RadioButtonTemple}" Name="btn_startPanel" Margin="0 40"
                         Command="{Binding ViewChangedCommand}"
                         CommandParameter="KnowledgeBaseView"/>
                    <RadioButton  Content="模型设置"   Template="{StaticResource RadioButtonTemple}"  Name="btn_controlPanel" Margin="0 40"
                         Command="{Binding ViewChangedCommand}"
                         CommandParameter="SpaceAdjustView"/>
                </StackPanel>
            </Grid>

            <!-- 右侧内容容器 -->
            <ContentControl x:Name="ViewContainer" Grid.Column="2" />
        </Grid>
    </Border>
</UserControl>
