<UserControl x:Class="RapidKnowledgeware.Views.KnowledgeBaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RapidKnowledgeware.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="608" FontSize="13">
    <Grid Background="white">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10 0 20 0">
                <Label Content="当前嵌入模型："  />
                <TextBox Text="{Binding KnowledgeBaseModel.CurrentEmbeddingName, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="5 0 0 0" MinWidth="50" BorderThickness="0 0 0 1" Padding="10 0" FontSize="12" 
                         VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
            </StackPanel>
            <!--多个分隔符请用英文逗号分隔，例如：###,##-->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Label Content="分块规则：" />
                <TextBox Text="{Binding KnowledgeBaseModel.BlockRule, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="5 0 0 0" MinWidth="50" BorderThickness="0 0 0 1" Padding="10 0" FontSize="12" 
                         VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
            </StackPanel>
        </StackPanel>

        <Button Content="添加文件" Margin="0 0 10 0" Height="30" Width="100" HorizontalAlignment="Right"
                Command="{Binding AddKnowledgeCommand}"/>

        <Grid Grid.Row="1">
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding KnowledgeBaseModel.FileItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#DDD" BorderThickness="0 0 0 1" Padding="5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- 文件名按钮，点击查看分块 -->
                                    <Button Content="{Binding FileName}" 
                                            Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" 
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Command="{Binding DataContext.ViewFileBlocksCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                    <!-- 删除按钮 -->
                                    <Button Grid.Column="1" Content="删除" Width="40" Margin="5 0"
                                            Command="{Binding DataContext.DeleteFileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- 浮层显示 FileBlockView，从上滑下 -->
        <Grid x:Name="FileBlockOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="Transparent" Margin="0 0 0 0">
            <local:FileBlockView x:Name="FileBlockViewControl" Width="599" Height="499"
                                 HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                 RenderTransformOrigin="0.5,0.5">
                <local:FileBlockView.RenderTransform>
                    <TranslateTransform Y="-400"/>
                </local:FileBlockView.RenderTransform>
            </local:FileBlockView>
        </Grid>
    </Grid>
</UserControl>