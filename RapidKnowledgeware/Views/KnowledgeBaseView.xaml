<UserControl x:Class="RapidKnowledgeware.Views.KnowledgeBaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RapidKnowledgeware.Views"
             xmlns:helper="clr-namespace:RapidKnowledgeware.Views.HelperView"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="748" FontSize="15">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="110"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏：包含切换按钮 -->
        <Border Grid.Row="0" Background="#F0F0F0" BorderBrush="#AAA" BorderThickness="0 0 0 1">
            <Button Content="{Binding SwitchViewButtonText}" Height="30" Width="120" HorizontalAlignment="Left" Margin="15 0 0 0"
                    Command="{Binding SwitchViewCommand}"/>
        </Border>

        <!-- 原有文件列表（保留） -->
        <Grid Grid.Row="2" Margin="10 10 10 0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding DisplayFileItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#DDD" BorderThickness="0 0 0 1" Padding="5" Margin="0 10 0 0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Content="{Binding FileName}" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" 
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Command="{Binding DataContext.ViewFileBlocksCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Grid.Column="1" Content="删除" Width="40" Margin="5 0"
                                            Command="{Binding DataContext.DeleteFileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
        <!-- 滑动视图容器：覆盖设置面板和文件列表区域 -->
        <Grid Grid.Row="1"  Background="Transparent">
            <!-- 知识库功能视图容器（默认显示） -->
            <Grid x:Name="FuncViewContainer" Visibility="Visible" Background="Transparent">
                <helper:KnowledgeBaseFuncView x:Name="FuncView"    
                                              RenderTransformOrigin="0.5,0.5">
                    <helper:KnowledgeBaseFuncView.RenderTransform>
                        <TranslateTransform X="0"/>
                    </helper:KnowledgeBaseFuncView.RenderTransform>
                </helper:KnowledgeBaseFuncView>
            </Grid>

            <!-- 搜索视图容器（默认隐藏于右侧外部） -->
            <Grid x:Name="SearchViewContainer" Visibility="Collapsed" Background="Transparent">
                <helper:KnowledgeBaseSearchView x:Name="SearchView" 
                                                RenderTransformOrigin="0.5,0.5">
                    <helper:KnowledgeBaseSearchView.RenderTransform>
                        <TranslateTransform X="748"/>
                        <!-- 初始置于右侧外部，宽度与容器一致 -->
                    </helper:KnowledgeBaseSearchView.RenderTransform>
                </helper:KnowledgeBaseSearchView>
            </Grid>
        </Grid>

        <!-- 浮层显示 FileBlockView，从上滑下 -->
        <Grid x:Name="FileBlockOverlay" Grid.RowSpan="3" Visibility="Collapsed" Background="Transparent" Margin="0 0 0 5">
            <local:FileBlockView x:Name="FileBlockViewControl" Width="802" Height="602"
                                 HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                 RenderTransformOrigin="0.5,0.5">
                <local:FileBlockView.RenderTransform>
                    <TranslateTransform Y="-400"/>
                </local:FileBlockView.RenderTransform>
            </local:FileBlockView>
        </Grid>
    </Grid>
</UserControl>