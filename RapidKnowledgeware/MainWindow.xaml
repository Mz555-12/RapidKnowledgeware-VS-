<Window x:Class="RapidKnowledgeware.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RapidKnowledgeware"
        xmlns:views="clr-namespace:RapidKnowledgeware.Views"
        mc:Ignorable="d"
        Title="RapidKnowledgeware" Height="590" Width="797" ResizeMode="NoResize"  FontSize="13.5" FontWeight="Normal" FontFamily="Microsoft YaHei" Background="{x:Null}" WindowStyle="None" WindowStartupLocation="CenterScreen" AllowsTransparency="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="./Styles/MainWindowStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>

    </Window.Resources>
    <Border Background="White" Margin="5" CornerRadius="10"> 
        <Border.Effect>
            <DropShadowEffect Color="Gray" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
        </Border.Effect>
        <Grid >
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition />
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>
            <Border Style="{StaticResource TitleBarStyle}"  CornerRadius="10 10 0 0">
                <Grid Background="#00FFFFFF"  MouseLeftButtonDown="RowDefinition_MouseLeftButtonDown">
                    <Label Content="RapidKnowledgeware V1.0" VerticalAlignment="Center" Margin="5,0,0,0" FontSize="13" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
                        <Border Height="30" Width="40"  VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border BorderBrush="Gray" BorderThickness="0" Width="40"  HorizontalAlignment="Center" Margin="0,1" Name="border_top">
                                <Button Template="{StaticResource ButtonTemplate}" Content="&#xe67b;" FontWeight="Bold" FontSize="19" Click="TopWindow_Click" BorderThickness="0" Background="#55DAE3EA"/>
                            </Border>
                        </Border>
                        <Button Height="30" Width="40" Template="{StaticResource ButtonTemplate}" Content="&#xe62e;" Visibility="Visible"  BorderThickness="0" FontWeight="Bold" FontSize="19"  Background="#55DAE3EA" Margin="10,0"
                                Command="{Binding OpenSpaceParametersViewCommand}"/>
                        <Button Height="30" Width="40" Template="{StaticResource ButtonTemplate}" Content="&#xe650;" Click="Minimum_Click" BorderThickness="0"  FontWeight="Bold" FontSize="19" Background="#55DAE3EA" Margin="10,0"/>
                        <Button Height="30" Width="40" Template="{StaticResource ButtonTemplate}" Content="&#xe601;" FontWeight="Bold" BorderThickness="0"  Background="#55DAE3EA"
            Command="{Binding CloseMainWindowCommand}"
            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>

                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="15 0 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <!-- 分隔条 -->
                <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Stretch" Background="#B4D6F1" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"/>


                <Grid>

                </Grid>
            </Grid>
            <Border Grid.Row="2" BorderBrush="#0078D7" BorderThickness="0 1 0 0">
                <TextBlock Text="{Binding MainModel.ViewInfo}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="13.5" Foreground="#595959" Margin="0 0 10 0"/> 
            </Border>
            

            <Grid Grid.RowSpan="2" x:Name="OverlayContainer" 
      Visibility="Collapsed"   
                Background="Transparent" Width="797" Height="500" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                <views:SpaceParametersView x:Name="SpaceView" 
                 
                 RenderTransformOrigin="0.5,0.5">
                    <views:SpaceParametersView.RenderTransform>
                        <TranslateTransform Y="-570"/>
                        <!-- 初始偏移量与高度一致 -->
                    </views:SpaceParametersView.RenderTransform>
                </views:SpaceParametersView>
            </Grid>
        </Grid>
    </Border>
</Window>
