<Window x:Class="RapidKnowledgeware.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RapidKnowledgeware"
        xmlns:views="clr-namespace:RapidKnowledgeware.Views"
        xmlns:converters="clr-namespace:RapidKnowledgeware.Converters"
        mc:Ignorable="d"
        Title="RapidKnowledgeware" Height="700" Width="1000" ResizeMode="NoResize"  FontSize="13.5" FontWeight="Normal" FontFamily="Microsoft YaHei" Background="{x:Null}" WindowStyle="None" WindowStartupLocation="CenterScreen" AllowsTransparency="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="./Assets/Styles/MainWindowStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <FrameworkElement x:Key="WindowProxy" DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>

            <ControlTemplate TargetType="Button" x:Key="OpenDebugBtn_Template">
                <Border
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}" 
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="4">
                    <ContentControl Content="{TemplateBinding Content}"   Name="text" 
                          FontFamily="{StaticResource iconfont}"  
                          VerticalAlignment="Center" 
                          HorizontalAlignment="Center"
                          Foreground="{StaticResource TextPrimary}"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Foreground" Value="#D0E8FF" TargetName="text"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <ControlTemplate TargetType="ToggleButton" x:Key="DeepThinkingTBtn_Template">
                <Border Name="back" 
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}" 
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="10">
                    <StackPanel Orientation="Horizontal" >
                        <Label Content="&#xe639;" Name="lable" FontFamily="{StaticResource iconfont}" FontSize="12" Margin="1 0 0 0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <TextBlock Text="{TemplateBinding Content}" Name="text" FontSize="{TemplateBinding FontSize}" VerticalAlignment="Center"   Margin="0 0 6 0" Foreground="{StaticResource TextPrimary}" FontFamily="Microsoft YaHei"/>
                        
                    </StackPanel>
               
                </Border>
                <ControlTemplate.Triggers>
                    <!-- 选中状态（优先级最高，放在最后） -->
                    <Trigger Property="IsChecked" Value="True">
                        <Setter Property="Background" Value="#edf3fe" TargetName="back"/>
                        <Setter Property="Foreground" Value="#3964fe" TargetName="text"/>
                        <Setter Property="BorderBrush" Value="#b7c8fe" TargetName="back"/>
                        <Setter Property="Foreground" Value="#3964fe" TargetName="lable"/>
                    </Trigger>
                    <!-- 鼠标悬浮状态（仅当未选中时生效） -->
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsMouseOver" Value="True"/>
                            <Condition Property="IsChecked" Value="False"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="Background" Value="#EEE" TargetName="back"/>
                    </MultiTrigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </ResourceDictionary>

    </Window.Resources>
    <Border Background="White" Margin="5" CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect Color="Gray" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
        </Border.Effect>
        <Grid >
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition />
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>
            <Border Style="{StaticResource TitleBarStyle}"  CornerRadius="10 10 0 0">
                <Grid Background="#00FFFFFF"  MouseLeftButtonDown="RowDefinition_MouseLeftButtonDown">

                    <Button Content="RapidKnowledgeware V1.0" Background="Transparent" Foreground="red" 
                            BorderThickness="0" Height="25" VerticalAlignment="Center"  
                            HorizontalAlignment="Left" Margin="7,0,0,0" FontSize="14" FontWeight="Bold"
                            Template="{StaticResource OpenDebugBtn_Template}"
                            Command="{Binding OpenDebugWindowCommand}"/>


                    <Grid HorizontalAlignment="Right" Margin="0,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <!-- 置顶按钮容器 -->
                            <ColumnDefinition Width="60"/>
                            <!-- 日志按钮 -->
                            <ColumnDefinition Width="60"/>
                            <!-- 空间参数按钮 -->
                            <ColumnDefinition Width="60"/>
                            <!-- 最小化按钮 -->
                            <ColumnDefinition Width="60"/>
                            <!-- 关闭按钮 -->
                        </Grid.ColumnDefinitions>

                        <!-- 置顶按钮） -->
                        <ToggleButton Height="30" Width="40" Template="{StaticResource ToggleButtonTemplate}" Name="TopWindow_Btn" Content="&#xe67b;" FontWeight="Bold" FontSize="19" Click="TopWindow_Click" BorderThickness="0" Background="#55DAE3EA"/>
                        <!-- 日志按钮 -->
                        <ToggleButton Grid.Column="1" Height="30" Width="40" Template="{StaticResource ToggleButtonTemplate}" Name="OpenLoggingView_Btn" Content="&#xe60c;" Visibility="Visible" BorderThickness="0" FontWeight="Bold" FontSize="19" Background="#55DAE3EA" Margin="10,0"
                                      Click="LogViewButton_Click" Command="{Binding LogCommand}"/>

                        <!-- 空间参数按钮 -->
                        <ToggleButton Grid.Column="2" Height="30" Width="40" Template="{StaticResource ToggleButtonTemplate}" Name="OpenSpaceParametersView_Btn" Content="&#xe62e;" Visibility="Visible" BorderThickness="0" FontWeight="Bold" FontSize="19" Background="#55DAE3EA" Margin="10,0"
                                      Click="SpaceViewButton_Click" Command="{Binding OpenSpaceParametersViewCommand}"/>

                        <!-- 最小化按钮 -->
                        <Button Grid.Column="3" Height="30" Width="40" Template="{StaticResource ButtonTemplate}" Name="Minimum_Btn" Content="&#xe650;" Click="Minimum_Click" BorderThickness="0" FontWeight="Bold" FontSize="19" Background="#55DAE3EA" Margin="10,0"/>

                        <!-- 关闭按钮 -->
                        <Button Grid.Column="4" Height="30" Width="40" Template="{StaticResource ButtonTemplate}" Name="CloseWindow_Btn" Content="&#xe601;" FontWeight="Bold" BorderThickness="0" Background="#55DAE3EA"
                                Command="{Binding CloseMainWindowCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0 0 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.7*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <!-- 分隔条 -->
                <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Stretch" Background="#B4D6F1" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"/>



                <!--左侧导航栏-->
                <Grid Background="#f9fafb">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Button Content="开启新对话" Command="{Binding NewSessionCommand}" Template="{StaticResource NewDialogueBtnStyle}"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Sessions}" >
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton GroupName="ChatSessions"
             IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
             Content="{Binding DisplayName}"
             Style="{StaticResource SessionRadioButtonStyle}"
             Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <RadioButton.ContextMenu>
                                            <ContextMenu Opened="ContextMenu_Opened" Visibility="{Binding PlacementTarget.Tag.IsSpaceAdjustVisible, RelativeSource={RelativeSource Self}, Converter={StaticResource InverseBoolToVis}}">

                                                <MenuItem Header="删除" 
                  Command="{Binding PlacementTarget.Tag.DeleteSessionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  CommandParameter="{Binding}"/>
                                                <MenuItem Header="编辑" 
Command="{Binding PlacementTarget.Tag.EditSessionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
CommandParameter="{Binding}"/>
                                                <Separator/>
                                                <MenuItem Header="重命名" 
Command="{Binding PlacementTarget.Tag.RenameSessionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
CommandParameter="{Binding}"/>
                                            </ContextMenu>
                                        </RadioButton.ContextMenu>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!--右侧内容容器-->
                <Grid Grid.Column="2" Background="#f9fafb">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding SelectedSession.SpaceParameters.ChatLLM, FallbackValue='未选择模型'}" FontSize="14" Margin="10 0 0 0" VerticalAlignment="Bottom" Foreground="#AAA"/>
                    <TextBlock Text="{Binding SelectedSession.DisplayName, FallbackValue='未选择对话'}" FontSize="14" Margin="10 0 0 0" VerticalAlignment="Bottom" Foreground="#AAA" HorizontalAlignment="Center"/>

                    <!--聊天窗口-->
                    <ScrollViewer Grid.Row="1" x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto"  Margin="0 10 0 0">
                        <ItemsControl ItemsSource="{Binding CurrentMessages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="20,5,20,5" Background="Transparent">
                                        <!-- 用户消息（右侧） -->
                                        <Border Background="#95EC69" 
                                                HorizontalAlignment="Right" 
                                                CornerRadius="5" 
                                                Margin="50,0,0,5"
                                                Visibility="{Binding IsUserMessage, Converter={StaticResource BoolToVis}}">
                                            <TextBox Text="{Binding UserContent}" 
                                                     Margin="10" 
                                                     TextWrapping="Wrap" 
                                                     IsReadOnly="True" 
                                                     MaxWidth="370"
                                                     Background="Transparent" 
                                                     BorderBrush="Transparent" 
                                                     BorderThickness="0"/>
                                        </Border>

                                        <!-- AI消息（左侧） -->
                                        <Border Background="#FFFFFF" 
                                                HorizontalAlignment="Left" 
                                                CornerRadius="5" 
                                                Margin="0,0,50,5"
                                                Visibility="{Binding IsUserMessage, Converter={StaticResource InverseBoolToVis}}" Padding="10">
                                            <Grid>
                                                <StackPanel>
                                                    <!-- 可折叠的 think 区域 -->
                                                    <Expander x:Name="ThinkExpander"
                                                              Header="思考过程" 
                                                              IsExpanded="False" 
                                                              Margin="10,5,10,5" 
                                                              Foreground="#7597DB" 
                                                              Background="Transparent"
                                                              Visibility="{Binding HasThinkContent, Converter={StaticResource BoolToVis}}">
                                                        <TextBox Text="{Binding ThinkingContent}" 
                                                                 Margin="0,5,0,0"
                                                                 TextWrapping="Wrap" 
                                                                 IsReadOnly="True" 
                                                                 Foreground="#7597DB"
                                                                 MaxWidth="390"  
                                                                 BorderBrush="Transparent" 
                                                                 BorderThickness="0"/>
                                                    </Expander>

                                                    <!-- 正式回答内容 -->
                                                    <TextBox Text="{Binding Content2}"  
                                                             Visibility="{Binding HasMainContent, Converter={StaticResource BoolToVis}}"
                                                             Margin="10,5,10,10"  
                                                             TextWrapping="Wrap" 
                                                             IsReadOnly="True" 
                                                             MaxWidth="390"  
                                                             BorderBrush="Transparent" 
                                                             BorderThickness="0"/>
                                                </StackPanel>

                                                <!-- 加载动画（正在思考） -->
                                                <Grid MinHeight="20"  
                                                      Margin="10,5,4,0" 
                                                      HorizontalAlignment="Left" 
                                                      VerticalAlignment="Top"
                                                      Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock x:Name="scanText" 
                                                               Text="正在思考 (๑•ㅂ•)و✧" 
                                                               Foreground="Gray" 
                                                               FontSize="14" 
                                                               HorizontalAlignment="Left" 
                                                               VerticalAlignment="Center"/>

                                                    <!-- 扫光层 -->
                                                    <TextBlock Text="正在思考 (๑" 
                                                               FontSize="14"  
                                                               HorizontalAlignment="Left" 
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Foreground>
                                                            <LinearGradientBrush x:Name="scanGradient" 
                                                                                 StartPoint="0,0.5" 
                                                                                 EndPoint="1,0.5">
                                                                <GradientStop Color="Transparent" Offset="0"/>
                                                                <GradientStop Color="Transparent" Offset="0.1"/>
                                                                <GradientStop Color="White" Offset="0.5"/>
                                                                <GradientStop Color="Transparent" Offset="0.9"/>
                                                                <GradientStop Color="Transparent" Offset="1"/>
                                                                <LinearGradientBrush.Transform>
                                                                    <TransformGroup>
                                                                        <TranslateTransform x:Name="scanTransform" X="-10"/>
                                                                    </TransformGroup>
                                                                </LinearGradientBrush.Transform>
                                                            </LinearGradientBrush>
                                                        </TextBlock.Foreground>
                                                        <TextBlock.Effect>
                                                            <BlurEffect Radius="1.5"/>
                                                        </TextBlock.Effect>
                                                        <TextBlock.Triggers>
                                                            <EventTrigger RoutedEvent="TextBlock.Loaded">
                                                                <BeginStoryboard>
                                                                    <Storyboard RepeatBehavior="Forever">
                                                                        <DoubleAnimation
                                                                            Storyboard.TargetName="scanGradient"
                                                                            Storyboard.TargetProperty="(LinearGradientBrush.Transform).(TransformGroup.Children)[0].(TranslateTransform.X)"
                                                                            From="-100" To="100" Duration="0:0:2"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </EventTrigger>
                                                        </TextBlock.Triggers>
                                                    </TextBlock>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!--发消息栏-->
                    <!-- 动态区域：覆盖 Grid.Row="1" 和 Grid.Row="2"，根据是否有消息切换布局 -->
                    <!-- 无消息时的居中布局（覆盖聊天区域） -->
                    <Grid Grid.Row="1" Grid.RowSpan="2" Visibility="{Binding HasMessages, Converter={StaticResource InverseBoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{Binding GreetingText}" 
                                   FontSize="24" FontWeight="Bold" 
                                   HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                   Foreground="#333" Margin="0 0 0 20"/>
                        <Border Grid.Row="1" BorderBrush="#CCC" BorderThickness="1" CornerRadius="15" 
                                Height="110" Width="500" HorizontalAlignment="Center">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="40"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <TextBox Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" 
                                             FontSize="14" Padding="10 10 10 5" Background="Transparent" 
                                             TextWrapping="Wrap" BorderThickness="0" AcceptsReturn="True"
                                             x:Name="CenterInputBox"
                                             TextChanged="InputBox_TextChanged"
                                             VerticalScrollBarVisibility="Auto">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Modifiers="Ctrl" Command="{Binding SendMessageCommand}" />
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <TextBlock Text="Ctrl+Enter 发送" 
                                              FontSize="14" 
                                              Foreground="#AAA" 
                                              FontStyle="Italic"
                                              HorizontalAlignment="Left" 
                                              VerticalAlignment="Top"
                                              Margin="12,10,0,0"
                                              IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding ElementName=CenterInputBox, Path=IsKeyboardFocused}" Value="False"/>
                                                            <Condition Binding="{Binding Text, ElementName=CenterInputBox}" Value=""/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <Grid Grid.Row="1">
                                    
                                    
                                    
                                    <!-- 发送按钮：IsSending == false 时显示 -->
                                    <Button Content="&#xe7fc;" BorderThickness="0" Template="{StaticResource SendMessageBtn}" 
        HorizontalAlignment="Right" Margin="0 0 10 0" Foreground="#3964fe" FontSize="28"
        Command="{Binding SendMessageCommand}"
        Visibility="{Binding IsSending, Converter={StaticResource InverseBoolToVis}}"/>

                                    <!-- 停止按钮：IsSending == true 时显示 -->
                                    <Button Content="&#xe800;" BorderThickness="0" Template="{StaticResource SendMessageBtn}" 
        HorizontalAlignment="Right" Margin="0 0.2 7.9 0" Foreground="#3964fe" FontSize="32.2"
        Command="{Binding StopMessageCommand}"
        Visibility="{Binding IsSending, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"/>

                                    <ToggleButton Content="深度思考" Background="Transparent" BorderBrush="#AAA" BorderThickness="1"  HorizontalAlignment="Left" Margin="10 0 0 6" VerticalAlignment="Bottom"  FontSize="10" Template="{StaticResource DeepThinkingTBtn_Template}"/>
                                </Grid>

                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 有消息时的底部布局（原位置） -->
                    <Grid Grid.Row="2" Visibility="{Binding HasMessages, Converter={StaticResource BoolToVis}}">
                        <Border BorderBrush="#CCC" BorderThickness="1" CornerRadius="15" Height="110" Margin="20 10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="40"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <TextBox Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" 
                                                 FontSize="14" Padding="10 10 10 0" Background="Transparent" 
                                                 TextWrapping="Wrap" BorderThickness="0" AcceptsReturn="True"
                                                 x:Name="BottomInputBox"
                                                 TextChanged="InputBox_TextChanged"
                                                 VerticalScrollBarVisibility="Auto" Margin="0 0 0 10">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Modifiers="Ctrl" Command="{Binding SendMessageCommand}" />
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <TextBlock Text="Ctrl+Enter 发送" 
                                                  FontSize="14" 
                                                  Foreground="#AAA" 
                                                  FontStyle="Italic"
                                                  HorizontalAlignment="Left" 
                                                  VerticalAlignment="Top"
                                                  Margin="12,10,0,0"
                                                  IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding ElementName=BottomInputBox, Path=IsKeyboardFocused}" Value="False"/>
                                                            <Condition Binding="{Binding Text, ElementName=BottomInputBox}" Value=""/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <Grid Grid.Row="1">
                                     <!-- 发送按钮：IsSending == false 时显示 -->
                                <Button Content="&#xe7fc;" BorderThickness="0" Template="{StaticResource SendMessageBtn}" 
                                    HorizontalAlignment="Right" Margin="0 0 10 0" Foreground="#3964fe" FontSize="28"
                                    Command="{Binding SendMessageCommand}"
                                    Visibility="{Binding IsSending, Converter={StaticResource InverseBoolToVis}}"/>

                                <!-- 停止按钮：IsSending == true 时显示 -->
                                <Button Content="&#xe800;" BorderThickness="0" Template="{StaticResource SendMessageBtn}" 
                                        HorizontalAlignment="Right" Margin="0 0.2 7.9 0" Foreground="#3964fe" FontSize="32.2"
                                        Command="{Binding StopMessageCommand}"
                                        Visibility="{Binding IsSending, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"/>
                                    <ToggleButton Content="深度思考" Background="Transparent" BorderBrush="#AAA" BorderThickness="1"  HorizontalAlignment="Left" Margin="10 0 0 6" VerticalAlignment="Bottom"  FontSize="10" Template="{StaticResource DeepThinkingTBtn_Template}"/>
                                </Grid>

                            </Grid>
                        </Border>
                    </Grid>


                    <!--SpaceAdjustView-->
                    <Grid Grid.RowSpan="3" x:Name="SpaceAdjustOverlay" Visibility="{Binding IsSpaceAdjustVisible, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                        <views:SpaceAdjustView x:Name="SpaceAdjustViewControl" 
                               DataContext="{Binding SpaceAdjustVM}"
                               RenderTransformOrigin="0.5,0.5">
                            <views:SpaceAdjustView.RenderTransform>
                                <TranslateTransform X="-1000"/>
                            </views:SpaceAdjustView.RenderTransform>
                        </views:SpaceAdjustView>
                    </Grid>

                </Grid>

            </Grid>










            <Border Grid.Row="2" BorderBrush="#0078D7" BorderThickness="0 1 0 0">
                <TextBlock Text="{Binding MainModel.ViewInfo}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="13.5" Foreground="#595959" Margin="0 0 10 0"/>
            </Border>


            <Grid Grid.RowSpan="2" x:Name="OverlayContainer" 
      Visibility="Collapsed"   
      Background="Transparent" Width="1000" Height="610" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                <views:SpaceParametersView x:Name="SpaceView" 
                               RenderTransformOrigin="0.5,0.5">
                    <views:SpaceParametersView.RenderTransform>
                        <TranslateTransform X="-1000"/>
                        <!-- 初始 X 偏移与容器宽度一致，从左侧滑入 -->
                    </views:SpaceParametersView.RenderTransform>
                </views:SpaceParametersView>
            </Grid>


            <!-- 日志视图覆盖层 -->
            <Grid Grid.RowSpan="2" x:Name="LogOverlayContainer" 
                  Visibility="Collapsed"   
                  Background="Transparent" Width="990" Height="610" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                <views:LoggingView x:Name="LogView" 
                                   RenderTransformOrigin="0.5,0.5">
                    <views:LoggingView.RenderTransform>
                        <TranslateTransform X="-1000"/>
                        <!-- -1000 -->
                    </views:LoggingView.RenderTransform>
                </views:LoggingView>
            </Grid>


            <!-- 覆盖层，用于放置加载动画 -->
            <Grid Background="Transparent" Grid.Row="1" Name="Loading_Grid" Visibility="Collapsed">
                <Grid.Resources>
                    <Style x:Key="ellipse" TargetType="Ellipse">
                        <Setter Property="Width" Value="10"/>
                        <Setter Property="Height" Value="10"/>
                        <Setter Property="Canvas.Left" Value="42.5"/>
                        <Setter Property="Fill" Value="Gray"/>
                        <Setter Property="RenderTransformOrigin" Value="0.5,3.33"/>
                    </Style>

                    <PowerEase x:Key="powerease" Power="3" EasingMode="EaseInOut"/>

                </Grid.Resources>
                <Border Background="#80FFFFFF"/>
                <Canvas Width="100" Height="100">
                    <Canvas.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="e1" To="360" Duration="0:0:2" EasingFunction="{StaticResource powerease}" AccelerationRatio="0.1" DecelerationRatio="0.9"/>
                                    <DoubleAnimation Storyboard.TargetName="e2" To="360" Duration="0:0:2" EasingFunction="{StaticResource powerease}" AccelerationRatio="0.3" DecelerationRatio="0.7"/>
                                    <DoubleAnimation Storyboard.TargetName="e3" To="360" Duration="0:0:2" EasingFunction="{StaticResource powerease}" AccelerationRatio="0.5" DecelerationRatio="0.5"/>
                                    <DoubleAnimation Storyboard.TargetName="e4" To="360" Duration="0:0:2" EasingFunction="{StaticResource powerease}" AccelerationRatio="0.7" DecelerationRatio="0.3"/>
                                    <DoubleAnimation Storyboard.TargetName="e5" To="360" Duration="0:0:2" EasingFunction="{StaticResource powerease}" AccelerationRatio="0.9" DecelerationRatio="0.1"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Canvas.Triggers>

                    <Label Content="Loading" 
FontSize="11"
FontFamily="Times New Roman"
Foreground="#BAB9B9"
FontWeight="Bold"
Width="93" 
Height="70"
VerticalContentAlignment="Center" 
HorizontalContentAlignment="Center"/>

                    <Ellipse Name="e1" Style="{StaticResource ellipse}">
                        <Ellipse.RenderTransform>
                            <RotateTransform Angle="0"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse Name="e2" Style="{StaticResource ellipse}">
                        <Ellipse.RenderTransform>
                            <RotateTransform Angle="0"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse Name="e3" Style="{StaticResource ellipse}">
                        <Ellipse.RenderTransform>
                            <RotateTransform Angle="0"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse Name="e4" Style="{StaticResource ellipse}">
                        <Ellipse.RenderTransform>
                            <RotateTransform Angle="0"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse Name="e5" Style="{StaticResource ellipse}">
                        <Ellipse.RenderTransform>
                            <RotateTransform Angle="0"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Canvas>
            </Grid>
        </Grid>
    </Border>
</Window>
